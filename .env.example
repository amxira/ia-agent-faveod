# --- Reasoning engine (OpenRouter) ---
# Free DeepSeek-R1 on OpenRouter: https://openrouter.ai/deepseek/deepseek-r1:free
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-r1:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90

# --- Embeddings (Google Gemini, free tier) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini            # gemini | local
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Vector store (Qdrant) ---
# Leave QDRANT_URL empty to use an in-memory store (dev). Set to http://localhost:6333 when Docker is up.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tender_chunks

# --- Anti-hallucination guardrail ---
# Below this embedding-similarity the criterion is NOT evaluated by the LLM and
# reported as "Unspecified - Manual review required".
SIMILARITY_THRESHOLD=0.75
TOP_K=6

# --- Text chunking ---
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# --- Scraping ---
# Comma-separated source names: sample, world_bank, ebrd, afdb, imf
SOURCES=sample,world_bank,ebrd
# Optional comma-separated proxy list (free rotating proxies, e.g. scheme://host:port).
# No paid residential service is required in dev; leave empty for direct access.
PROXY_LIST=

# --- Data locations ---
DATA_DIR=data
