# --- Reasoning engine (OpenRouter) ---
# Free models rotate frequently. The client auto-discovers a working free model
# if this one disappears. Paid DeepSeek-R1 alternative: deepseek/deepseek-r1
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90

# --- Embeddings (Google Gemini, free tier) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini            # gemini | local
GEMINI_EMBED_MODEL=gemini-embedding-001
# Seconds between embedding batches (free-tier RPM throttling)
GEMINI_RATE_LIMIT_SLEEP=0.5

# --- Vector store (Qdrant) ---
# Leave QDRANT_URL empty to use an in-memory store (dev). Set to http://localhost:6333 when Docker is up.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tender_chunks

# --- Anti-hallucination guardrail ---
# Below this embedding-similarity the criterion is NOT evaluated by the LLM and
# reported as "Unspecified - Manual review required".
SIMILARITY_THRESHOLD=0.75
TOP_K=6

# --- Text chunking ---
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# --- Scraping ---
# Comma-separated source names: sample, world_bank, ebrd, afdb, imf
SOURCES=sample,world_bank,ebrd
# Optional comma-separated proxy list (free rotating proxies, e.g. scheme://host:port).
# No paid residential service is required in dev; leave empty for direct access.
PROXY_LIST=

# --- Data locations ---
DATA_DIR=data

# --- Agent 2 (Partner Scout) ---
# Search backend: "sample" (offline demo) | "searxng" (self-hosted meta-search).
SEARCH_SOURCE=sample
SEARXNG_URL=http://localhost:8080
SEARCH_TERMS="Software Engineering,Systems Integrator,IT Services,Custom Software Development"
TARGET_COUNTRIES="Morocco,Senegal,Tunisia,Egypt,Saudi Arabia,United Arab Emirates"
SEARCH_PER_QUERY=10
MAX_COMPANIES=40

# --- Partner Scout analysis & qualification ---
MAX_PAGES_PER_COMPANY=8
MIN_PAGE_TEXT_CHARS=200
# Companies scoring >= AFFINITY_THRESHOLD are written to qualified_partners.json.
AFFINITY_THRESHOLD=60

# --- Agent 3 (Event Mapper & Lead Profiler) ---
# Event backend: "sample" (offline demo) | "ten_times" | "eventbrite" | "luma" | "news"
EVENT_SOURCE=sample
EVENT_COUNTRIES="Morocco,Senegal,Tunisia,Egypt,Saudi Arabia,United Arab Emirates"
EVENT_KEYWORDS="IT Summit,Digital Transformation Africa,Cybersecurity Conference,CIO Summit,Technology Summit"
MAX_EVENTS=20
EVENT_FETCH_TIMEOUT=45

# --- Event page scraping & NER ---
MAX_PAGES_PER_EVENT=6
MIN_PAGE_TEXT_CHARS=200

# --- Lead scoring ---
MAX_LEADS=40
# Leads scoring >= PRIORITY_THRESHOLD are written to priority_leads.json.
PRIORITY_THRESHOLD=70

# --- Phase 5 (Dashboard & Notifications) ---
# Alerts fire for tenders scoring >= TENDER_ALERT_THRESHOLD and for leads
# matching LEAD_PRIORITY_FILTER. Channels are enabled by setting their URL/keys;
# leave empty to disable. Console always prints.
TENDER_ALERT_THRESHOLD=80
NOTIFY_ON_LEADS=1
LEAD_PRIORITY_FILTER="HIGH PRIORITY"

# Slack incoming webhook (https://api.slack.com/messaging/webhooks)
NOTIFY_SLACK_WEBHOOK=
# Microsoft Teams incoming webhook
NOTIFY_TEAMS_WEBHOOK=
# SMTP email digest (any provider with STARTTLS on port 587)
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM=
NOTIFY_SMTP_TO=
